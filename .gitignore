# ML pipeline — datasets and generated artifacts are not committed.
# Whitelist only the curated docs/placeholders, nothing that a download or a
# pipeline run produces.
ml/data/**
!ml/data/
!ml/data/README.md
!ml/data/synthetic/
!ml/data/synthetic/.gitkeep
!ml/data/damoto/
!ml/data/damoto/README.md
ml/models/*
!ml/models/.gitkeep
*.pkl
*.meta.json
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# Firmware / PlatformIO
firmware/.pio/
firmware/.vscode/
*.bin
*.elf

# Flutter / app
app/.dart_tool/
app/build/
app/.flutter-plugins
app/.flutter-plugins-dependencies

# OS / editor
.DS_Store
Thumbs.db
.idea/
*.swp
